# Copy this file to .env and fill in YOUR OWN values.
# NEVER commit the real .env file to git. NEVER paste real values into
# chat tools, issue trackers, or screenshots.

# ---------------------------------------------------------------------
# Groww credentials
# ---------------------------------------------------------------------
# Option A (simplest): paste a daily access token generated from
# https://groww.in/user/profile/trading-apis  ("Generate API keys" ->
# "Access Token"). It expires every day at 6:00 AM IST, so you'll need
# to refresh it daily, or leave it blank and use Option B instead.
ACCESS_TOKEN=

# Option B: an API key + secret from https://groww.in/trade-api/api-keys
# The backend will use these to auto-generate an access token via
# Groww's "approval" flow. Requires that you approve API access for the
# current day in the Groww dashboard - see their docs.
GROWW_API_KEY=eyJraWQiOiJaTUtjVXciLCJhbGciOiJFUzI1NiJ9..KM9NB90tSO4c_aTS8ZqYYgom8HCDl3OgneWpQ9sY1nTP8GB08uvWrYqAO1IuIO3Vg8YCl80n3cwym8NZB__lQQ
GROWW_API_SECRET=FpSGhC8hHUHSpAY@!MDvlegbFX6oM6ke

# Base URL for Groww's API - only change this if Groww instructs you to
# use a different environment.
GROWW_API_BASE_URL=https://api.groww.in

# ---------------------------------------------------------------------
# CORS - comma-separated list of the exact frontend origin(s) allowed to
# call this API from a browser. No trailing slash. No wildcards.
# ---------------------------------------------------------------------
ALLOWED_ORIGINS=https://your-frontend-domain.com,http://localhost:3000

# ---------------------------------------------------------------------
# Optional: comma-separated NSE trading symbols for GET /watchlist.
# Groww's API does not expose a "saved watchlist" endpoint, so this
# route works off a symbol list you maintain yourself.
# ---------------------------------------------------------------------
WATCHLIST_SYMBOLS=RELIANCE,TCS,INFY

# ---------------------------------------------------------------------
# HTTP client behaviour
# ---------------------------------------------------------------------
REQUEST_TIMEOUT_SECONDS=10
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=0.5

# ---------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
